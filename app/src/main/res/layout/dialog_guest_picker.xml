<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dialog_background_modern"
    android:padding="24dp"
    android:minWidth="320dp"
    android:elevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_people_modern"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Who's staying?"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="16dp"
        android:background="@drawable/guest_item_modern"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adults"
                android:textSize="16sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ages 13+"
                android:textSize="13sp"
                android:textColor="#999999" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/buttonAdultMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="#2196F3"
                android:background="@drawable/counter_button_modern"
                app:backgroundTint="@null"
                android:padding="0dp"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/textViewAdultsCount"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:gravity="center"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonAdultPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="#2196F3"
                android:background="@drawable/counter_button_modern"
                app:backgroundTint="@null"
                android:padding="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="16dp"
        android:background="@drawable/guest_item_modern"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Children"
                android:textSize="16sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ages 0-12"
                android:textSize="13sp"
                android:textColor="#999999" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/buttonChildMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="#2196F3"
                android:background="@drawable/counter_button_modern"
                app:backgroundTint="@null"
                android:padding="0dp"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/textViewChildrenCount"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:gravity="center"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonChildPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="#2196F3"
                android:background="@drawable/counter_button_modern"
                app:backgroundTint="@null"
                android:padding="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#666666"
            android:textSize="14sp"
            android:background="@drawable/button_cancel_modern"
            app:backgroundTint="@null"
            android:layout_marginEnd="12dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/buttonConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Apply"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/button_confirm_modern"
            app:backgroundTint="@null"
            android:layout_marginStart="12dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>